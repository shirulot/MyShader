    <string name="demo_passthrough_title">原图直通</string>
    <string name="demo_passthrough_description">当前用于继续 Shader 练习；未参与最终输出的调节 uniform 不显示滑条。</string>
    <string name="demo_01_title">Demo 1 · 固定红色</string>
    <string name="demo_01_description">保留原图透明度，将每个片元的 RGB 输出为红色。</string>
    <string name="demo_02_title">Demo 2 · UV 红绿渐变</string>
    <string name="demo_02_description">把横向 UV 映射到红色、纵向 UV 映射到绿色。</string>
    <string name="demo_03_title">Demo 3 · 采样坐标偏移</string>
    <string name="demo_03_description">横向采样坐标增加 0.1，观察图像移动和边缘重复。</string>
    <string name="demo_04_title">Demo 4 · 整体变暗</string>
    <string name="demo_04_description">RGB 乘以 0.5，透明度保持不变。</string>
    <string name="demo_05_title">Demo 5 · 整体提亮</string>
    <string name="demo_05_description">RGB 乘以 1.2，并把结果限制在 1.0 以内。</string>
    <string name="demo_06_title">Demo 6 · 右半屏混白</string>
    <string name="demo_06_description">右半屏统一混入 15% 白色，展示非肤色识别式处理。</string>
    <string name="demo_07_title">Demo 7 · 条件混白</string>
    <string name="demo_07_description">仅在右半屏且满足简单肤色条件时混入白色。</string>
    <string name="demo_08_title">Demo 8 · 左右效果对比</string>
    <string name="demo_08_description">左右各显示一张完整人脸，右侧应用条件混白。</string>
    <string name="demo_09_title">Demo 9 · 黑白 Mask</string>
    <string name="demo_09_description">左侧保留原图，右侧用黑白显示暖色条件选中的像素。</string>
    <string name="demo_10_title">Demo 10 · 连续权重 Mask</string>
    <string name="demo_10_description">使用 smoothstep 计算连续肤色权重，并按权重混入白色。</string>
    <string name="demo_11_title">Demo 11 · 两点横向柔化</string>
    <string name="demo_11_description">右半屏平均当前像素与右侧邻居，观察最小邻域采样。</string>
    <string name="demo_12_title">Demo 12 · 三点横向柔化</string>
    <string name="demo_12_description" formatted="false">右半屏以 60%、20%、20% 混合左中右三个像素。</string>
    <string name="demo_13_title">Demo 13 · 肤色权重磨皮</string>
    <string name="demo_13_description">在三点平滑基础上，用连续肤色权重控制右半屏混合。</string>
    <string name="demo_14_title">Demo 14 · 边缘保护磨皮</string>
    <string name="demo_14_description">根据原色与平滑色差异降低模糊强度，保护局部轮廓。</string>
    <string name="demo_15_title">Demo 15 · 九点边缘保护磨皮</string>
    <string name="demo_15_description">以九点邻域平滑肤色，并根据边缘差异保护局部轮廓。</string>
    <string name="demo_16_title">Demo 16 · 九点边缘保护磨皮</string>
    <string name="demo_16_description">以九点邻域平滑肤色，并根据边缘差异保护局部轮廓。</string>
    <string name="demo_17_title">Demo 17 · 双边滤波磨皮</string>
    <string name="demo_17_description">按局部色差分配八方向采样权重，保留差异较大的细节。</string>
    <string name="demo_18_title">Demo 18 · 局部色差灰度图</string>
    <string name="demo_18_description">左侧放大显示原色与双边平滑色的局部色差，右侧保留原图。</string>
    <string name="demo_19_title">Demo 19 · 暖色磨皮</string>
    <string name="demo_19_description">左侧将双边平滑色微调为暖色后按肤色与边缘权重混合，右侧保留原图。</string>
    <string name="demo_20_title">Demo 20 · 局部暖色调试</string>
    <string name="demo_20_description">根据肤色与边缘遮罩，只在局部平滑结果上叠加轻微暖色，右侧保留原图。</string>
    <string name="demo_21_title">Demo 21 · 暖色强度参数</string>
    <string name="demo_21_description">通过 warmthStrength 参数限制局部暖色偏移，右侧保留原图。</string>
    <string name="demo_22_title">Demo 22 · 亮度与色度四分屏</string>
    <string name="demo_22_description">左侧显示色度与亮度，右侧对比当前处理结果与原图。</string>
    <string name="demo_23_title">Demo 23 · 中间亮度暖色调</string>
    <string name="demo_23_description">只在肤色、中间亮度且非边缘区域叠加暖色色度，观察亮度范围保护效果。</string>
    <string name="demo_24_title">Demo 24 · 中间亮度权重调试</string>
    <string name="demo_24_description">用灰度显示中间亮度权重，同时对比亮度、暖色处理结果与原图。</string>
    <string name="demo_25_title">Demo 25 · 暖色综合权重调试</string>
    <string name="demo_25_description">用灰度显示肤色、边缘和中间亮度共同计算的暖色权重，同时对比亮度与处理结果。</string>
    <string name="demo_26_title">Demo 26 · 色度增强</string>
    <string name="demo_26_description">从磨皮结果中分离亮度与色度，在保持亮度的基础上增强局部色彩并叠加暖色。</string>
    <string name="demo_27_title">Demo 27 · 暖色调色结果</string>
    <string name="demo_27_description">在肤色、中间亮度和边缘保护条件下完成暖色色度调整，输出最终处理结果。</string>
    <string name="demo_28_title">Demo 28 · 暖色/饱和度范围</string>
    <string name="demo_28_description">归档当前暖色调色结果，暖色/饱和度强度范围为 0.00 到 1.00。</string>
    <string name="demo_29_title">Demo 29 · 饱和度独立拖动</string>
    <string name="demo_29_description">将暖色补正与饱和度拆成独立控制，使用 saturationStrength 单独调节饱和度，范围为 0.00 到 0.30。</string>
    <string name="demo_30_title">Demo 30 · UV 旋转与前摄镜像</string>
    <string name="demo_30_description">通过纹理坐标变换完成 90 度旋转和左右镜像，观察输入方向对最终画面的影响。</string>
    <string name="demo_31_title">Demo 31 · UV 方向标记调试</string>
    <string name="demo_31_description">在旋转和前摄镜像后的 UV 左上角绘制洋红色标记，用于确认组合坐标方向。</string>
    <string name="demo_32_title">Demo 32 · YUV 色度采样</string>
    <string name="demo_32_description">保留逐像素亮度，将色度按 24×24 网格共享后用 Y/Cb/Cr 重建 RGB，观察色度分辨率变化。</string>
    <string name="demo_33_title">Demo 33 · RGB/YUV 往返转换</string>
    <string name="demo_33_description">将输入 RGB 转换为 Y/Cb/Cr 后再还原为 RGB，观察颜色空间转换与往返误差。</string>
    <string name="demo_34_title">Demo 34 · Gamma 亮度对比</string>
    <string name="demo_34_description">对比编码 RGB 直接减半与先转近似线性空间再减半的结果，观察 Gamma 对亮度变化的影响。</string>
    <string name="demo_35_title">Demo 35 · 白平衡暖色校正</string>
    <string name="demo_35_description">模拟暖光后，以左侧中性采样点反推 RGB 校正增益，观察白平衡对暖色偏移的校正效果。</string>
    <string name="demo_36_title">Demo 36 · 白平衡与曝光补偿</string>
    <string name="demo_36_description">依次对比模拟色偏、白平衡校正、白平衡加曝光补偿，观察中性参考如何同时影响颜色和亮度。</string>
    <string name="demo_group_basics">基础</string>
    <string name="demo_37_title">Demo 37 · RGB 通道四栏调试</string>
    <string name="demo_38_title">Demo 38 · 矩形区域遮罩</string>
    <string name="demo_39_title">Demo 39 · 矩形羽化遮罩</string>
    <string name="demo_40_title">Demo 40 · 羽化矩形局部提亮</string>
    <string name="demo_41_title">Demo 41 · HSV 肤色候选遮罩</string>
    <string name="demo_42_title">Demo 42 · 肤色与区域联合遮罩</string>
    <string name="demo_43_title">Demo 43 · 手工人脸框遮罩</string>
    <string name="demo_44_title">Demo 44 · 像素坐标转 UV 标记</string>
    <string name="demo_44_description">将模拟分析点的像素坐标除以设定的图片尺寸，转换为 UV 后在原图上绘制红色标记。</string>
    <string name="demo_43_description">根据手工指定的人脸框中心和宽高计算四条边界，以黑白遮罩显示框内区域，不依赖 SDK 人脸数据。</string>
    <string name="demo_42_description">将 HSV 肤色候选权重与羽化矩形区域权重相乘，以灰度显示同时满足颜色和位置条件的区域。</string>
    <string name="demo_41_description">结合色相、饱和度及 HSV 明度的阴影与高光保护条件，以灰度显示肤色候选权重。</string>
    <string name="demo_40_description">用羽化矩形遮罩混合原图与固定增加 0.25 的 RGB 提亮结果，观察局部处理边缘的平滑过渡。</string>
    <string name="demo_39_description">用 smoothstep 对矩形四条边进行羽化，以灰度显示中央区域及边缘的平滑过渡。</string>
    <string name="demo_38_description">用四个 step 边界限定 UV 中央矩形区域，区域内显示白色，区域外显示黑色。</string>
    <string name="demo_37_description">从左到右显示模拟偏色图，以及 R、G、B 通道的灰度图，观察各通道强度差异。</string>
    <string name="demo_group_whitening">美白</string>
    <string name="demo_group_skin_smoothing">磨皮</string>
    <string name="demo_group_local_color_difference_debug">局部色差调试</string>
    <string name="demo_group_brightness_and_chroma">亮度与色度</string>
    <string name="demo_group_image_input_and_color_management">图像输入与颜色管理</string>
    <string name="demo_group_face_analysis_and_mask">人脸分析与区域遮罩</string>
</resources>
