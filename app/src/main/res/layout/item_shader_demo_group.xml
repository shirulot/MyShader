<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_shader_demo_group"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_shader_demo_group_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shader_demo_group_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/shader_demo_group_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shader_demo_group_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/shader_demo_group_subtitle"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/shader_demo_group_indicator"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:padding="8dp"
        android:tint="@color/shader_demo_group_action" />

</LinearLayout>
